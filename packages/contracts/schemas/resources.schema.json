    "Connection": {
      "type": "object",
      "properties": {
        "apiVersion": {
          "const": "moria/v1alpha2"
        },
        "kind": {
          "const": "Connection"
        },
        "metadata": {
          "$ref": "#/$defs/Metadata"
        },
        "spec": {
          "type": "object",
          "properties": {
            "implementation": {
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z0-9_-]*/[A-Z][A-Za-z]*/[A-Za-z_][A-Za-z0-9_-]*$"
            },
            "configuration": {
              "type": "object"
            },
            "secrets": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[A-Za-z_][A-Za-z0-9_-]*/[A-Z][A-Za-z]*/[A-Za-z_][A-Za-z0-9_-]*$"
              },
              "minItems": 0,
              "uniqueItems": true
            },
            "output": {
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z0-9_-]*/[A-Z][A-Za-z]*/[A-Za-z_][A-Za-z0-9_-]*$"
            },
            "mode": {
              "enum": ["replace", "append", "upsert", "delete"]
            },
            "coverage": {
              "enum": ["full", "incremental", "appendOnly"]
            },
            "stream": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "implementation",
            "configuration",
            "secrets",
            "output",
            "mode",
            "coverage",
            "stream"
