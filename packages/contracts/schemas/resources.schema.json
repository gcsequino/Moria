            "args": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Expr"
              },
              "minItems": 2,
              "maxItems": 2
            }
          },
          "required": ["op", "args"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "enum": ["and", "or"]
            },
            "args": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Expr"
              },
              "minItems": 2
            }
          },
          "required": ["op", "args"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "enum": ["not", "isNull"]
            },
            "args": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Expr"
              },
              "minItems": 1,
              "maxItems": 1
            }
          },
          "required": ["op", "args"],
          "additionalProperties": false
        }
      ]
    },
    "Scope": {
      "type": "object",
      "properties": {
        "target": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_-]*/[A-Z][A-Za-z]*/[A-Za-z_][A-Za-z0-9_-]*$"
        },
        "operations": {
          "type": "array",
          "items": {
