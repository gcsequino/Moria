            "readPolicy": {
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z0-9_-]*/[A-Z][A-Za-z]*/[A-Za-z_][A-Za-z0-9_-]*$"
            },
            "writePolicy": {
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z0-9_-]*/[A-Z][A-Za-z]*/[A-Za-z_][A-Za-z0-9_-]*$"
            },
            "propertyPolicies": {
              "type": "object",
              "propertyNames": {
                "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
              },
              "additionalProperties": {
                "type": "object",
                "properties": {
                  "read": {
                    "type": "string",
                    "pattern": "^[A-Za-z_][A-Za-z0-9_-]*/[A-Z][A-Za-z]*/[A-Za-z_][A-Za-z0-9_-]*$"
