          },
          "required": ["op", "targetType", "uid", "property", "value"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "const": "clearOverride"
            },
            "targetType": {
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z0-9_-]*/[A-Z][A-Za-z]*/[A-Za-z_][A-Za-z0-9_-]*$"
            },
            "uid": {
              "$ref": "#/$defs/Expr"
            },
            "property": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": ["op", "targetType", "uid", "property"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "enum": ["delete", "restore"]
            },
            "targetType": {
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z0-9_-]*/[A-Z][A-Za-z]*/[A-Za-z_][A-Za-z0-9_-]*$"
            },
            "uid": {
              "$ref": "#/$defs/Expr"
            }
          },
          "required": ["op", "targetType", "uid"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "const": "create"
            },
            "targetType": {
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z0-9_-]*/[A-Z][A-Za-z]*/[A-Za-z_][A-Za-z0-9_-]*$"
            },
            "identityKey": {
              "$ref": "#/$defs/Expr"
            },
            "values": {
              "type": "object",
              "propertyNames": {
                "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
              },
              "additionalProperties": {
                "$ref": "#/$defs/Expr"
              },
              "minProperties": 1
            }
          },
          "required": ["op", "targetType", "identityKey", "values"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "enum": ["link", "unlink"]
            },
            "linkType": {
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z0-9_-]*/[A-Z][A-Za-z]*/[A-Za-z_][A-Za-z0-9_-]*$"
            },
            "sourceUid": {
              "$ref": "#/$defs/Expr"
            },
            "targetUid": {
              "$ref": "#/$defs/Expr"
            }
          },
          "required": ["op", "linkType", "sourceUid", "targetUid"],
          "additionalProperties": false
        }
      ]
    },
    "Namespace": {
      "type": "object",
      "properties": {
        "apiVersion": {
          "const": "moria/v1alpha2"
        },
        "kind": {
          "const": "Namespace"
        },
