              "pattern": "^[A-Za-z_][A-Za-z0-9_-]*/[A-Z][A-Za-z]*/[A-Za-z_][A-Za-z0-9_-]*$"
            }
          },
          "required": ["inputs", "targetType", "condition"],
          "additionalProperties": false,
          "oneOf": [
            {
              "required": ["edits"],
              "not": {
                "required": ["function"]
              }
            },
            {
              "required": ["function"],
              "not": {
                "required": ["edits"]
              }
            }
          ]
        }
      },
      "required": ["apiVersion", "kind", "metadata", "spec"],
      "additionalProperties": false
    },
    "Function": {
      "type": "object",
      "properties": {
        "apiVersion": {
          "const": "moria/v1alpha2"
        },
        "kind": {
          "const": "Function"
