              "type": "string",
              "minLength": 1
            },
            "targetProperty": {
              "type": "string",
              "minLength": 1
            },
            "readPolicy": {
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z0-9_-]*/[A-Z][A-Za-z]*/[A-Za-z_][A-Za-z0-9_-]*$"
            }
