          "properties": {
            "artifact": {
              "$ref": "#/$defs/Artifact"
            },
            "runtime": {
              "const": "typescript-v1"
            },
            "inputs": {
              "$ref": "https://spec.example.invalid/moria/types/v1/schema.json#/$defs/FunctionFields"
            },
            "outputs": {
              "$ref": "https://spec.example.invalid/moria/types/v1/schema.json#/$defs/FunctionFields"
            },
