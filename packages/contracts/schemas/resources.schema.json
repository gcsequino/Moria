          "pattern": "^[A-Za-z_][A-Za-z0-9_-]*$"
        },
        "markings": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_-]*/[A-Z][A-Za-z]*/[A-Za-z_][A-Za-z0-9_-]*$"
          },
          "minItems": 0,
          "uniqueItems": true
        }
      },
      "required": ["namespace", "name"],
      "additionalProperties": false
