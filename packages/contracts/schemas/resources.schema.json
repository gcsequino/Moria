    "Limits": {
      "type": "object",
      "properties": {
        "timeoutSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "memoryMiB": {
          "type": "integer",
          "minimum": 1
        },
        "cpuMillis": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": ["timeoutSeconds"],
      "additionalProperties": false
