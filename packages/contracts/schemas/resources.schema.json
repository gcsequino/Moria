{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spec.example.invalid/moria/v0.2/resources.schema.json",
  "title": "Moria resource declaration v0.2",
  "$ref": "#/$defs/Resource",
  "$defs": {
    "ScalarType": {
      "$ref": "https://spec.example.invalid/moria/types/v1/schema.json#/$defs/Scalar"
    },
    "ValueType": {
      "$ref": "https://spec.example.invalid/moria/types/v1/schema.json#/$defs/Column"
    },
    "Fields": {
      "$ref": "https://spec.example.invalid/moria/types/v1/schema.json#/$defs/Fields"
    },
    "Expr": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "literal": {
              "oneOf": [
                {
                  "type": ["string", "number", "boolean", "null"]
                },
                {
                  "type": "array",
                  "items": {
                    "type": ["string", "number", "boolean", "null"]
                  },
                  "minItems": 0
                }
              ]
            }
          },
          "required": ["literal"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "field": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": ["field"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "principalAttribute": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": ["principalAttribute"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "parameter": {
              "type": "string",
              "minLength": 1
