      },
      "required": ["apiVersion", "kind", "metadata", "spec"],
      "additionalProperties": false
    },
    "Dataset": {
      "type": "object",
      "properties": {
        "apiVersion": {
          "const": "moria/v1alpha2"
        },
        "kind": {
          "const": "Dataset"
        },
        "metadata": {
          "$ref": "#/$defs/Metadata"
        },
        "spec": {
          "type": "object",
          "properties": {
            "columns": {
              "$ref": "#/$defs/Fields"
            },
            "primaryKey": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
